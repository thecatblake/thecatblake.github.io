---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Blog">
	<section class="About">
		<ul class="Nav" style="flex-direction: column; align-items: flex-start;">
			{
				posts.map((post) => (
					<li class="Blog_Item">
						<a class="Nav_Link oswald-regular" href={`/blog/${post.id}`}>
							{post.data.title}
						</a>
						<span class="Blog_Date">
							{post.data.date.toLocaleDateString("ja-JP", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</span>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
